{
  "name": "nexiam-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:inspect": "cross-env NODE_OPTIONS=--inspect=9229 next build",
    "start:static": "npx serve -s dist",
    "start": "next start",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "ci": "biome ci",
    "fmt:data": "dprint fmt --allow-no-files",
    "fmt:data:check": "dprint check",
    "prepare": "husky",
    "dev:env": "cross-env NODE_ENV=development next dev",
    "prod:build": "cross-env NODE_ENV=production next build",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation bun payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation bun payload generate:types",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "build:opennext": "open-next build",
    "sst:dev": "sst dev",
    "sst:deploy": "sst deploy",
    "sst:deploy:dev": "sst deploy --stage dev",
    "sst:deploy:prod": "sst deploy --stage prod",
    "sst:deploy:preview": "sst deploy --stage preview",
    "sst:remove:preview": "sst remove --stage preview",
    "sst:console": "sst console"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.966.0",
    "@base-ui/react": "^1.0.0",
    "@bprogress/core": "^1.3.4",
    "@bprogress/next": "^3.2.12",
    "@bprogress/react": "^1.2.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@payloadcms/db-postgres": "^3.72.0",
    "@payloadcms/next": "^3.72.0",
    "@payloadcms/richtext-lexical": "^3.72.0",
    "@payloadcms/storage-s3": "^3.72.0",
    "@payloadcms/ui": "^3.72.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.12.0",
    "ky": "^1.14.2",
    "lucide-react": "^0.562.0",
    "mjml": "^4.18.0",
    "mjml-browser": "^4.18.0",
    "next": "16.1.1",
    "payload": "^3.72.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.70.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@opennextjs/aws": "3.10.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mjml": "^4.7.4",
    "@types/mjml-browser": "^4.15.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "dprint": "^0.54.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "sst": "4.8.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
