# ============================================
# LOCAL DEVELOPMENT ONLY
# ============================================
#
# Copy this file to .env.local and fill in the values:
#   cp .env.local.example .env.local
#
# This file is ONLY used for `bun run dev` on your machine.
# In AWS (any stage), non-secret config is set by sst.config.ts and the two
# Payload framework env vars (DATABASE_URL, PAYLOAD_SECRET) are fetched from
# SSM by _deploy.yml and injected into the Lambda environment.
# See .claude/rules/secrets-handling.md.
#
# NEVER commit .env.local. NEVER put real secrets in this example file.


# ============================================
# ENV DISCRIMINATOR (required)
# ============================================
#
# Tells src/lib/secrets.ts where to read app-level runtime secrets from:
#   ENV=local  → process.env fallback (this file)
#   ENV=dev / ENV=prod → AWS Parameters and Secrets Lambda Extension
#
# In Lambda, sst.config.ts sets ENV to the raw stage name ("prod", "dev",
# or any throwaway stage). Locally you must set it to "local" explicitly.

ENV=local
NODE_ENV=development


# ============================================
# PAYLOAD FRAMEWORK (required even locally)
# ============================================
#
# These two are read by payload.config.ts at module-init. Unlike landing's
# app-level secrets they do NOT go through getSecret() — Payload's buildConfig
# runs before any of our code can fetch them.
#
# In AWS: fetched from /common/DATABASE_URL and /common/PAYLOAD_SECRET by CI.
# Locally: paste the dev values here (or point DATABASE_URL at a local Postgres).

DATABASE_URL=
PAYLOAD_SECRET=


# ============================================
# NON-SECRET RUNTIME CONFIG
# (In AWS: set by sst.config.ts environment block, per stage.)
# ============================================

AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXT_PUBLIC_API_URL=http://backend.dev.nexiam.net
FROM_EMAIL=support@dev.nexiam.net
FROM_NAME=Nexiam Support
AWS_REGION=eu-central-1


# ============================================
# PAYLOAD ADMIN AUTO-LOGIN (dev convenience)
# (Only used when NODE_ENV=development — see payload.config.ts admin.autoLogin)
# ============================================

ADMIN_EMAIL=admin@nexiam.net
ADMIN_PASSWORD=
